# Copy to .env and fill in. Never commit the real .env.

# --- Required: the server refuses to boot without these ---
MONGODB_URI=mongodb://127.0.0.1:27017/careermate
JWT_SECRET=
S3_BUCKET=

# --- Optional ---
PORT=3000
NODE_ENV=dev
LOG_LEVEL=info
JWT_EXPIRES_IN=7d
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=

# AI chat. Without it the app still boots and /v1/chat/status reports
# configured:false; sending a message returns 503.
ANTHROPIC_API_KEY=

# Transactional email (Brevo). Without these the app still runs; outside
# production the message is logged instead of sent, so the flow is testable.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CareerMate AI
# Shown in the email footer so a recipient can reach a human. Optional;
# the line is left out entirely when it is not set.
EMAIL_SUPPORT_ADDRESS=
# Where the product lives. Used for the link in the email footer.
APP_URL=http://localhost:3000
# Comma-separated browser origins allowed to call this API. Required in
# production; http://localhost:3000 is allowed automatically elsewhere.
CORS_ORIGINS=
# How many proxy hops to trust for the client IP (rate limiting). Defaults to 1
# in production (Render's load balancer) and none elsewhere. Rarely needs setting.
TRUST_PROXY=

# Local testing account for `npm run seed:dev-user`. Both optional: the email
# defaults to dev@careermate.local and the password is generated per run.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
