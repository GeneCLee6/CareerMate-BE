# Copy to .env and fill in. Never commit the real .env.

# --- Required: the server refuses to boot without these ---
MONGODB_URI=mongodb://127.0.0.1:27017/careermate
JWT_SECRET=
S3_BUCKET=

# --- Optional ---
PORT=3000
NODE_ENV=dev
LOG_LEVEL=info
JWT_EXPIRES_IN=7d
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=

# AI chat. Without it the app still boots and /v1/chat/status reports
# configured:false; sending a message returns 503.
ANTHROPIC_API_KEY=

# Transactional email (Brevo). Without these the app still runs; outside
# production the message is logged instead of sent, so the flow is testable.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CareerMate AI
